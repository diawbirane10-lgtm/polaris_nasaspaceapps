{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {"src":"/terms","dest":"/public/terms.html"},
    {
      "src": "/(api/.*|admin|terms)",
      "dest": "/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/",
      "dest": "/public/workspace.html"
    },
    {
      "src": "/demo",
      "dest": "/public/index.html"
    },
    {
      "src": "/workspace",
      "dest": "/public/workspace.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}