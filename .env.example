# ONLY from a NEW dedicated Supabase project, not other existing applications.
POLARIS_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
POLARIS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only. Add to Vercel environment secrets; never in JS, docs or git.
POLARIS_SUPABASE_SERVER_KEY=SET_ONLY_IN_HOSTING_SECRET_MANAGER
